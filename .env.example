# Copy to .env (git-ignored) and fill in. Never commit real keys.

# gpt-oss-120b via any OpenAI-compatible host. The key must belong to the SAME host as the base URL
# (an OpenRouter key starts with sk-or-; an OpenAI platform key will not work on OpenRouter).
#   OpenRouter: https://openrouter.ai/api/v1   model openai/gpt-oss-120b
#   Groq:       https://api.groq.com/openai/v1 model openai/gpt-oss-120b
#   Together:   https://api.together.xyz/v1    model openai/gpt-oss-120b
GPT_OSS_API_KEY=
GPT_OSS_BASE_URL=https://openrouter.ai/api/v1
GPT_OSS_MODEL=openai/gpt-oss-120b

# DeepSeek API (check their docs for the current model id)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Only needed if you point any role at a claude-* model in config.py
ANTHROPIC_API_KEY=
